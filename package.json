{
  "name": "dbs-card-companion",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/verify-rules.ts && tsx scripts/verify-arena.ts && tsx scripts/verify-db.mts",
    "contract:emit": "tsx scripts/verify-arena.ts --emit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:check": "tsx scripts/db-check.mts",
    "db:migrate:http": "tsx scripts/db-migrate.mts",
    "sync:catalog": "tsx scripts/sync-catalog.mts",
    "sync:prices": "tsx scripts/sync-prices.mts",
    "sync:meta": "tsx scripts/sync-meta.mts",
    "sync:all": "tsx scripts/sync-catalog.mts && tsx scripts/sync-prices.mts && tsx scripts/sync-meta.mts",
    "import:starters": "tsx scripts/import-starter-decks.mts",
    "arena:fuzz": "tsx --env-file-if-exists=.env.local scripts/arena-fuzz.mts",
    "arena:coverage": "tsx --env-file-if-exists=.env.local scripts/arena-coverage.mts",
    "arena:playthrough": "tsx --env-file-if-exists=.env.local scripts/arena-playthrough.mts",
    "arena:vs": "tsx --env-file-if-exists=.env.local scripts/arena-vs-claude.mts",
    "arena:gaps": "tsx --env-file-if-exists=.env.local scripts/arena-gaps.mts",
    "arena:feedback": "tsx --env-file-if-exists=.env.local scripts/arena-feedback.mts",
    "arena:rule": "tsx --env-file-if-exists=.env.local scripts/arena-rule.mts",
    "arena:draft": "tsx scripts/arena-draft.mts",
    "arena:probe": "tsx --env-file-if-exists=.env.local scripts/arena-probe.mts",
    "arena:reprobe": "tsx --env-file-if-exists=.env.local scripts/arena-probe.mts --reprobe",
    "arena:tally": "tsx scripts/arena-catalog-tally.mts",
    "arena:readings": "tsx scripts/arena-readings.mts",
    "arena:diff": "tsx --env-file-if-exists=.env.local scripts/arena-diff.mts",
    "arena:migrate-scripts": "tsx scripts/arena-migrate-scripts.mts",
    "icons": "tsx scripts/make-icons.mts",
    "android:test": "docker compose -f android/compose.yaml run --rm contract"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@neondatabase/serverless": "^1.1.0",
    "drizzle-orm": "^0.45.2",
    "motion": "^13.2.0",
    "next": "16.3.0",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
