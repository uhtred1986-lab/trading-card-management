# Postgres connection string. Neon (pooled) in production; local Docker for dev:
#   DATABASE_URL="postgresql://postgres:devpassword@localhost:5432/postgres"
DATABASE_URL=

# Anthropic — deck analysis, improvement wizard, set review, card-scan identification.
ANTHROPIC_API_KEY=

# Protects the cron-triggered price sync route. Vercel sends it as a Bearer token.
CRON_SECRET=

# HTTP Basic Auth for the whole app (see src/proxy.ts). Leave both unset for local
# dev — the app runs open. Set both on any deployment reachable from the internet;
# the app has no login of its own.
# BASIC_AUTH_USER=
# BASIC_AUTH_PASSWORD=

# Optional — EU marketplace listings + cart optimizer (§5). Leave empty to disable.
CARDTRADER_API_TOKEN=

# Optional — multi-card batch photo detection (§1 Path A). Leave empty to use Claude vision.
XIMILAR_API_KEY=
