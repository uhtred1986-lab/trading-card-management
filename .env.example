# Copy to .env.local (gitignored). Names only; see CLAUDE.md "Environment".
DATABASE_URL=
ANTHROPIC_API_KEY=
# Same Anthropic key under a second name, read when the first is absent.
APP_ANTHROPIC_API_KEY=
CARDTRADER_API_TOKEN=
CARDTRADER_ENABLED=
# Optional.
CRON_SECRET=
XIMILAR_API_KEY=
# Basic Auth: both set turns it on (Vercel Production/Preview only; leave unset locally, where the app runs open).
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
# Arena admins: comma-separated Basic Auth logins who see the engine internals (REF badge, debug drawer, /arena/[id]/debug).
# With Basic Auth on and this unset, nobody is admin. With Basic Auth off (local dev), everyone is.
ARENA_ADMINS=
