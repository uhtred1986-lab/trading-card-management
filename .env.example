# Copy to .env.local (gitignored). Names only; see CLAUDE.md "Environment".
DATABASE_URL=
ANTHROPIC_API_KEY=
# Same Anthropic key under a second name, read when the first is absent.
APP_ANTHROPIC_API_KEY=
# Claude plan subscription: get from `claude setup-token`, and set CLAUDE_CODE_OAUTH_TOKEN_CREATED to the date (YYYY-MM-DD).
CLAUDE_CODE_OAUTH_TOKEN=
APP_CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_CODE_OAUTH_TOKEN_CREATED=
# OpenRouter (any vendor's model through one key); OPENROUTER_APP_URL is optional app attribution.
OPENROUTER_API_KEY=
OPENROUTER_APP_URL=
# Which AI provider to use (default anthropic-api).
AI_PROVIDER=
# Puts the Agent SDK's 246 MB binary into ONE route (/api/ai/agent-sdk) and lets the plan run on Vercel. Set it in Vercel only after the route PR is merged and measured (#518).
AI_AGENT_SDK=
# Shared secret between the functions and that route (any long random string; same value everywhere). Unset = the route refuses everyone.
AI_AGENT_SDK_SECRET=
# Optional: base URL the functions call the route on (default: the deployment's own VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL).
AI_AGENT_SDK_URL=
CARDTRADER_API_TOKEN=
CARDTRADER_ENABLED=
# Optional.
CRON_SECRET=
XIMILAR_API_KEY=
# Google sign-in for SLs (docs/architecture/auth.md). All four set turns it on; then a signed-out page goes to /login.
# AUTH_SECRET: random, at least 32 characters (signs the session cookie). SL_EMAILS: comma-separated Google addresses.
# The OAuth client's redirect URIs: https://trading-card-management.vercel.app/api/auth/callback/google and http://localhost:3000/api/auth/callback/google
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SL_EMAILS=
# Basic Auth (being replaced; still accepted beside Google): both set turns it on (Vercel Production/Preview only; leave unset locally, where the app runs open).
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
# While Basic Auth lasts: comma-separated app_users logins that count as SLs (see everything, Settings, the engine internals).
# Every Google-signed-in SL is one anyway; other password logins are players.
ARENA_ADMINS=
