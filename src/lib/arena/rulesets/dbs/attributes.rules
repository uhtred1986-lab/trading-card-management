-- What a card and a player have, as declarations.
--
-- Sections are `docs/rules/rulemanual.txt`: §2 is the parts of a card, §1-2
-- energy costs (total and specified), §1-9 the front and back sides, §1-14
-- energy markers, §9-9-1 the order continuous effects are applied in, §20-1
-- names a skill gives a card in all areas and §20-21 increasing or reducing
-- an energy cost.
--
-- `printed: true` means the value is read off the card itself — "the
-- information specified on a card itself", which §9-9-1-1 makes the base
-- reference for everything below it. `layers:` is the order the game then
-- applies to reach the value the rules actually use, §9-9-1 throughout:
--   printed   the face value (9-9-1-1)
--   rewrite   every continuous effect except those that rewrite a number
--             (9-9-1-2)
--   numeric   the continuous effects that rewrite a number (9-9-1-3)
-- A cost has its own two layers because a reduction is not a rewrite of the
-- printed cost but a discount on the price being paid (20-21): `reduction`
-- is the flat one, `specified` the coloured one, and they move apart —
-- `docs/arena-history-lessons.md`, 8 Sep 2026 and the owner's BT19-039
-- ruling of 9 Sep 2026. The two therefore sit on *different* attributes:
-- `reduction` on both halves of a price, since taking 1 off a total takes one
-- orb with it (20-21-2), and `specified` on the coloured half alone, which is
-- what "moves the total nothing" means when it is written down.
--
-- Where an attribute's real domain cannot be said in this grammar — `value:`
-- knows five shapes and no enum, no union and no map — the text says what the
-- domain is instead, and the history entry of 12 Sep 2026 records the gap
-- rather than the file stretching to cover it.

-- ── printed on the card (§2) ───────────────────────────────────────────────

DEFINE ATTRIBUTE id                                                       -- §2-14
  of: card
  value: string
  printed: true
  text: "the card number, which is what a copy limit and every reference to a card counts by (2-14, 6-1-5-1)"

DEFINE ATTRIBUTE name                                                     -- §2-3
  of: card
  value: string
  printed: true
  text: "the card name (2-3)"

DEFINE ATTRIBUTE type                                                     -- §2-1
  of: card
  value: string
  printed: true
  text: "the card type, one of LEADER, BATTLE, EXTRA, UNISON, Z-LEADER, Z-BATTLE, Z-EXTRA, Z-UNISON and TOKEN (2-1, 10 to 19)"

DEFINE ATTRIBUTE colors                                                   -- §2-2
  of: card
  value: colors
  printed: true
  text: "the card's colors: red, blue, green, yellow, black, white, or none of them (1-8, 2-2)"

DEFINE ATTRIBUTE energyCost                                               -- §2-5
  of: card
  value: number
  printed: true
  text: "the total cost of playing the card from hand; an X cost is a number its master chooses when it is paid and zero at every other time (1-2-2, 1-2-2-2)"

DEFINE ATTRIBUTE specifiedCost                                            -- §1-2-3
  of: card
  value: colors
  printed: true
  layers: [printed, reduction, specified]
  text: "the coloured orbs of the energy cost, one entry per orb, that must be matched in colour when the cost is paid (1-2-3, 5-3); a flat reduction takes an orb off with each energy it takes off the total (20-21-2), and the `specified` layer is the half that relaxes or tightens the colours alone without moving the total at all"

DEFINE ATTRIBUTE zEnergyCost                                             -- §2-6
  of: card
  value: number
  printed: true
  text: "the Z-Energy cost of playing the card from the Z-Deck (1-4, 2-6)"

DEFINE ATTRIBUTE power                                                    -- §2-7
  of: card
  value: number
  printed: true
  layers: [printed, rewrite, numeric]
  text: "the number a battle is decided by (2-7, 8-4); combo power is added to it only in the Damage Step (5-7)"

-- 20-3-1 — the printed face value, said on its own so that nothing has to
-- read it back off `power` once 9-9-1's layers have been applied to that one.
-- It has no `CardDef` field of its own (`vm/cards.ts`'s `CATALOG` is keyed by
-- one), because the face showing is not the catalog row: a flipped Leader
-- answers with its awakened side and a card in Hidden Mode with nothing at all
-- (1-9, 23-5-2), which is `vm/program.ts`'s `facePower` and the legacy
-- `face()`. `layers: [printed]` is what says the board fills it and no layer
-- moves it — the same shape `mode` and `markers` below take.
DEFINE ATTRIBUTE originalPower                                            -- §20-3-1
  of: card
  value: number
  printed: false
  layers: [printed]
  text: "the power printed on the face this card is showing, before any skill effect has applied (20-3-1); a Hidden Mode card has none to read at all (23-5-2)"

DEFINE ATTRIBUTE comboCost                                                -- §2-9
  of: card
  value: number
  printed: true
  text: "the energy paid to use the card in a combo (2-9, 5-6)"

DEFINE ATTRIBUTE comboPower                                               -- §2-8
  of: card
  value: number
  printed: true
  layers: [printed, rewrite, numeric]
  text: "the power the card adds when it is used in a combo (2-8, 5-7)"

DEFINE ATTRIBUTE characters                                               -- §2-10
  of: card
  value: strings
  printed: true
  text: "the character names the card carries, written in angle brackets (2-10)"

DEFINE ATTRIBUTE traits                                                   -- §2-11
  of: card
  value: strings
  printed: true
  text: "the special traits the card carries, written in double angle brackets (2-11)"

DEFINE ATTRIBUTE skill                                                    -- §2-4
  of: card
  value: string
  printed: true
  text: "the card's text box, which is every skill it has before any is gained or negated (2-4, 1-5)"

DEFINE ATTRIBUTE back                                                     -- §1-9
  of: card
  value: boolean
  printed: true
  text: "whether the card has a back side to turn to — a Leader's awakened face, or a Z-Leader's single face (1-9). What is printed on that face is a face of its own, which this grammar has no kind for; see the history entry of 12 Sep 2026"

DEFINE ATTRIBUTE alsoNames                                                -- §20-1
  of: card
  value: strings
  printed: false
  text: "the card names a skill gave this card in all areas; it answers to these as well as to its printed name, never instead of it (20-1)"

-- ── a card's state on the table (spec §2.5-1/§2.5-3, #275) ─────────────────
--
-- `modifyAttr` reached one card and six attributes before this issue
-- (docs/arena-ruleset-spec.md §2.5-1); these are the six the compiler's own
-- `switchMode`, `addMarker`/`removeMarker`, `grant`, `hidden`, `faceUp` and
-- `flip` already write, declared so the primitive can reach them too and
-- `vm/effects.ts` has a layer order to read them through. None has a printed
-- face on the catalog row — each starts at a rules-given default and is
-- changed directly, on the card sitting on the table, never by a continuous
-- effect with a duration — so `layers: [printed]` alone is the honest
-- declaration for five of them: the "printed" layer is not the catalog, it
-- is whatever the table currently says. `keywords` is the one exception,
-- because a keyword actually is granted for a duration (13-4's marker
-- skills, most [Auto]/[Activate] "gains [X]" text) as well as standing from
-- a [Permanent] — the `rewrite`/`numeric` split 9-9-1 already draws for
-- `power`. What a granted keyword then *does* is Stage 7's hook contract
-- (#153-#157), out of scope here; this attribute only says which names are
-- in force.

DEFINE ATTRIBUTE mode                                                     -- §1-10
  of: card
  value: string
  printed: false
  layers: [printed]
  text: "Active Mode or Rest Mode (1-10). Switched directly (`switchMode`), never by a continuous effect, so the printed layer is the only one — read fresh off the card on the table and nowhere else"

DEFINE ATTRIBUTE markers                                                  -- §1-11
  of: card
  value: number
  printed: false
  layers: [printed]
  text: "the markers on this card (1-11), changed directly (`addMarker`/`removeMarker`) and never by a continuous effect with a duration, so the printed layer is the only one. Energy markers are a player's, not a card's — `energyMarkers` below (1-14)"

DEFINE ATTRIBUTE keywords                                                 -- §9-1-3, §22-1
  of: card
  value: strings
  printed: false
  layers: [printed, rewrite, numeric]
  text: "the keyword names in force: the printed ones, a [Permanent]'s standing grant (rewrite, 9-9-1-2) and a resolved skill's own grant for a duration (numeric, 9-9-1-3) unioned in. A negated keyword is read where a skill is negated at all (9-1-5), not through this attribute"

DEFINE ATTRIBUTE hidden                                                   -- §23-5
  of: card
  value: boolean
  printed: false
  layers: [printed]
  text: "Hidden Mode (face down in play, no information) or Revealed Mode (23-5). Switched directly, never by a continuous effect, so the printed layer is the only one — read fresh off the card on the table"

DEFINE ATTRIBUTE faceUp                                                   -- §3-9-2-1
  of: card
  value: boolean
  printed: false
  layers: [printed]
  text: "whether a card in a closed area — a Life Area — has been turned face up (3-9-2-1). Switched directly, never by a continuous effect, so the printed layer is the only one — read fresh off the card on the table"

DEFINE ATTRIBUTE flipped                                                  -- §1-9, §22-2-4
  of: card
  value: boolean
  printed: false
  layers: [printed]
  text: "whether the card has turned to its back side — a Leader's awakened face (1-9, 22-2-4). Switched directly, never by a continuous effect, so the printed layer is the only one — read fresh off the card on the table"

-- ── what the board makes of them (§9-9-1, §20-21) ──────────────────────────

DEFINE ATTRIBUTE costOf                                                   -- §20-21
  of: card
  value: number
  printed: false
  layers: [printed, reduction]
  text: "the total price of playing this card as it stands: the printed total cost, less every cost reduction in force, and never less than zero (20-21-1, 20-21-2). The coloured half of the same price is `specifiedCost`, which carries the `specified` layer, because a sentence that relaxes which colours are demanded moves the total nothing at all — the owner's BT19-039 ruling of 9 Sep 2026"

DEFINE ATTRIBUTE comboCostOf                                              -- §20-21
  of: card
  value: number
  printed: false
  layers: [printed, reduction]
  text: "the combo cost as it stands, after every reducer in force, and never less than zero (5-7-3, 20-21-2)"

DEFINE ATTRIBUTE zEnergyCostOf                                            -- §20-21
  of: card
  value: number
  printed: false
  layers: [printed, reduction]
  text: "the Z-Energy cost as it stands, after every reducer in force, and never less than zero (5-4, 20-21-2)"

-- ── what a player has (§1-14) ──────────────────────────────────────────────

DEFINE ATTRIBUTE energyMarkers                                            -- §1-14
  of: player
  value: number
  printed: false
  text: "the energy markers in a player's Energy Area: each pays one energy of the Leader's colour, and neither is a card nor is energy (1-14-1, 1-14-2, 1-14-3)"

-- These two are facts about a player rather than about the board, which is
-- the gap #145's charge and #157's growUnison were left standing on: 7-2-11's
-- one charge and 13-3's one Unison growth are each a player having "already
-- had" one this turn, and until now the language had no word for that,
-- letting the charge's `REFUSE` only borrow a proxy word instead
-- (`asking(prompt: charge)`, which said which question was on the table
-- rather than the fact itself). `reset: turnStart` is the ceiling, read by
-- `vm/flow.ts`'s `endTurn` off the declaration rather than picked out of it
-- by name — the same promise `LIMIT n` on a step makes for a repeat (issue
-- #269).

DEFINE ATTRIBUTE charged                                                  -- §7-2-11
  of: player
  value: boolean
  printed: false
  reset: turnStart
  text: "whether this player has had their one charge this turn (7-2-11); true from the moment the Charge Phase's own question is answered, charging or not, since that is the only opportunity this engine offers one at"

DEFINE ATTRIBUTE grewUnison                                               -- §13-3
  of: player
  value: boolean
  printed: false
  reset: turnStart
  text: "whether this player has already grown their Unison Card this turn (13-3); set the moment growUnison resolves"
