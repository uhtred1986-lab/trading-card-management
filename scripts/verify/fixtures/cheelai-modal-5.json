    "faq": [
      {
        "name": "Cheelai and Lemo",
        "qa": [
          {
            "q": "During your turn, if your opponent deals damage to you by using a skill, can you add cards from your life to your hand?",
            "a": "No, you can\u2019t."
          },
          {
            "q": "Can you activate this card\u2019s [Wish] skill when there are no\u3008Broly : Br\u3009 cards in your Drop Area?",
            "a": "Yes, you can.\nEven if there are no\u3008Broly : Br\u3009 cards in your Drop Area, as long as the \u201cWhen there are 7 Dragon Ball cards in your Drop Area\u201d condition is met, you can activate and resolve the card\u2019s [Wish] skill."
          },
          {
            "q": "Can you look at your life after looking at your deck with this card\u2019s auto skill?",
            "a": "Yes, you can.\nHowever, make sure to resolve the skill as quickly as possible, and do not look at other cards unless absolutely necessary."
          }
        ]
      },
      {
        "name": "Cheelai and Lemo, the Kindhearted",
        "qa": [
          {
            "q": "During your turn, if your opponent deals damage to you by using a skill, can you add cards from your life to your hand?",
            "a": "No, you can\u2019t."
          },
          {
            "q": "When using this card\u2019s skill to activate [Activate] skills on cards with \u226aDesire\u226b, do you have to pay the energy cost on the activated card?",
            "a": "No, you don\u2019t have to pay unless specified otherwise."
          },
          {
            "q": "This card has a skill that reads: \u201cChoose 1 green or black \u226aDesire\u226b card in your hand with an energy cost less than or equal to your current energy and activate its [Activate : Main] skill.\u201d\nWhen you use this skill to activate an [Activate : Main] skill on a card in your hand, does that card remain in your hand?",
            "a": "No, it doesn\u2019t. The skill places the card with \u226aDesire\u226b in your Drop Area, and then activates its [Activate : Main] skill."
          },
          {
            "q": "Where should I place cards that have been \u201cremoved from the game\u201d?",
            "a": "Cards that have been removed from the game should be placed face up in an area separate from your Drop Area and Warp that is visible to all players."
          }
        ]
      }
    ]
  },
