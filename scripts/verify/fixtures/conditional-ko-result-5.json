  "BT2-006": {
    "card": {
      "id": "BT2-006",
      "type": "BATTLE",
      "colors": [
        "Red"
      ],
      "cost": "6",
      "specified": null,
      "z": null,
      "power": 25000,
      "name": "Miraculous Comeback Ultimate Gohan",
      "characters": [
        "Son Gohan: Adolescence"
      ],
      "traits": [
        "Saiyan",
        "Earthling"
      ],
      "skill": "[Double Strike]<br>[Permanent] If you have only 3 or less cards besides this card in your hand, reduce the energy cost of this card in your hand or Battle Area by 4.<br>[Auto] When this card KO-s your opponent's Battle Card, inflict 2 damage to your opponent.",
      "backName": null,
      "backSkill": null
    },
    "faq": [
      {
        "name": "Miraculous Comeback Ultimate Gohan",
        "qa": [
          {
            "q": "When you have 3 or less cards in your hand, can you KO {BT2‐006 Miraculous Comeback Ultimate Gohan} with {BT1‐063 Son Goten, Family of Justice}’s auto skill?",
            "a": "Yes, you can.\nIf the controller has 3 or less cards in their hand, the energy cost of {BT2‐006 Miraculous Comeback Ultimate Gohan} in the Battle Area becomes 2, so it can be KO-ed by {BT1‐063 Son Goten, Family of Justice}’s auto skill."
          },
          {
            "q": "{BT2‐006 Miraculous Comeback Ultimate Gohan} inflicted damage to the opponent with its auto skill. Does the owner of {BT2‐006 Miraculous Comeback Ultimate Gohan} choose which cards the opponent adds from the Life Area to their hand?",
            "a": "No, they do not.\nThe player who was damaged chooses which cards to add to their hand."
          },
          {
            "q": "If {Miraculous Comeback Ultimate Gohan} is attacked while it has [Revenge] and KOs your opponent’s Battle Card with [Revenge], can you use this card’s auto skill to deal damage to your opponent?",
            "a": "Yes, you can.\n{BT2-006 Miraculous Comeback Ultimate Gohan}’s auto skill still activates when it KOs a card with one of its skills."
          },
          {
            "q": "If {BT2-006 Miraculous Comeback Ultimate Gohan} KOs a Battle Card with [Revenge], does its auto skill activate?",
            "a": "Yes, it does."
          },
          {
            "q": "{BT2‐006 Miraculous Comeback Ultimate Gohan}’s energy cost was decreased by 4 due to its permanent skill. Does the remaining cost need to be paid with the specified color?",
            "a": "Yes, it does."
          }
        ]
      }
    ],
