    "faq": [
      {
        "name": "King Cold, Father of the Emperor",
        "qa": [
          {
            "q": "When activating the [Counter] skill of a Battle Card, can you activate it without paying the card’s energy cost?",
            "a": "No, you must pay the energy cost.\n[Counter] skills can be activated from your hand by paying the card’s energy cost."
          },
          {
            "q": "When playing cards with card skills, do you need to pay the energy cost of that card?",
            "a": "No, you do not need to pay unless specified otherwise."
          },
          {
            "q": "You used this card’s [Counter: Battle Card Attack] to make this card the target of an attack. Can you KO the attacking card using [Revenge] at the end of the battle?",
            "a": "Yes, it does.\nRevenge activates when the card is attacked, or at the end of that battle, and KOs the opponent’s card."
          },
          {
            "q": "You activated {BT1-107Cold Bloodlust} against {BT1-091King Cold, Father of the Emperor}’s [Counter]. In this case, does the target of the attack still change?",
            "a": "Yes, it does."
          }
        ]
