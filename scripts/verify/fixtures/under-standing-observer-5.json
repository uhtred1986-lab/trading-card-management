      "name": "Son Goku, The Awakened Power",
      "characters": [
        "Son Goku"
      ],
      "traits": [
        "Saiyan",
        "Universe 7"
      ],
      "skill": "[ex-evolve] {1}, place 1 ≪Universe 7≫ from your hand in the Drop Area: ≪Universe 7≫ <Son Goku> with an energy cost of 6 or more.<br>[ultimate] <br>[victory strike](When you deal life damage by attacking with this card, you win the game)<br>[permanent] This card's attack and skill cannot be negated.",
      "backName": null,
      "backSkill": null
    },
    "FAQ": [
      {
        "name": "Son Goku, The Awakened Power",
        "qa": [
          {
            "q": "You use [EX-Evolve] to play a card on top of a card in Rest Mode. What position does the evolved card enter play in?",
            "a": "It enters play in Rest Mode.\nCards played on top of other cards retain the position of the cards placed below them."
          },
          {
            "q": "You use [EX-Evolve] to play a card on top of a card that received +5000 power and [Double Strike] for the duration of the turn. Do these power boosts and skills transfer to the new card?",
            "a": "The new card retains the +5000 power boost, but does not receive [Double Strike]. When playing cards on top of other cards, only changes to power transfer. Any skills granted to the cards placed below do not carry over to the new card."
          },
          {
            "q": "Can this card attack even when effects like “Battle Cards can’t attack” are in effect?",
            "a": "No, it can’t.\n“Battle Cards can’t attack” effects are not effects which negate attacks."
          },
          {
            "q": "When this card attacks, can your opponent activate [Blocker]?",
            "a": "Yes, they can."
          },
          {
            "q": "What happens when you deal damage to an opponent’s life using a card that has both [Double Strike] and [Victory Strike]?",
            "a": "You win the game."
          },
          {
            "q": "If your opponent’s Leader Card is {BT2-034 Absolute God Fused Zamasu}, can you win the game using [Victory Strike]?",
            "a": "Yes, you can."
          }
        ]
      }
    ]
  },
