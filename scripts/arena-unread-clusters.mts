/**
 * `npm run arena:unread-clusters -- --readings <readings.json> --out <dir> [--label <text>]`
 *
 * The audit lanes' work list, offline: reads the output of `arena:compile-snapshot` (one reading per skill) and
 * writes, per compiler lane, every unread skill clustered by the wording of its first unread clause — names,
 * colours and numbers normalised, largest cluster first:
 *
 *   moments.md     [Auto] skills whose unread clause is their moment (lane T: triggers)
 *   conditions.md  the first unread clause reads like a condition       (lane C)
 *   selectors.md   …like a choice, a description or a place            (lane S)
 *   effects.md     everything else                                      (lane E)
 *
 * The split is a wording heuristic, not a parse: a clause filed under one lane may belong to another, and the
 * lane that finds one leaves it. Skills refused on purpose (a program that would play the Leader or a card already
 * in play, the Potara/Fusion/Evolution rebuilds) are left out. No database, no network.
 */
import fs from "node:fs";
import path from "node:path";

const arg = (name: string) => { const i = process.argv.indexOf(name); return i > 0 ? process.argv[i + 1] : undefined; };
const readingsFile = arg("--readings"), outDir = arg("--out"), label = arg("--label") ?? "";
if (!readingsFile || !outDir) throw new Error("usage: arena:unread-clusters -- --readings <readings.json> --out <dir> [--label <text>]");

interface Reading { kind: string; trigger: string[]; reads: string; unread: string[]; printed: string }
const readings = JSON.parse(fs.readFileSync(readingsFile, "utf8")) as Record<string, Reading>;

const MOMENT = /^(?:\[[^\]]*\]\s*)*(?:when(?:ever)?|at the (?:start|end|beginning)|each time|activate this skill when|after|if this card is (?:removed|ko'?d|placed))\b/i;
const isMoment = (u: string) => MOMENT.test(u.trim()) || /^an \[Auto\] that names no moment/.test(u);
const REFUSED_ON_PURPOSE = /would play the Leader|already in play|rebuild|unsupported Fusion|POTARA|EVOLUTION/i;
const norm = (u: string) => u.toLowerCase().replace(/<[^>]*>|≪[^≫]*≫|\{[^}]*\}/g, "X").replace(/\d+/g, "N").replace(/\b(red|blue|green|yellow|black|white)\b/g, "C").replace(/\s+/g, " ").trim().slice(0, 90);
function laneOf(u: string): "conditions" | "selectors" | "effects" {
  const t = u.toLowerCase();
  if (/^(?:if|while|during|unless|as long as|only if)\b|\bif (?:you|your|there|this|that|it)\b.*(?:,|:)/.test(t) && !/^if .*\b(?:choose|play|draw|ko|place|add)\b/.test(t)) return "conditions";
  if (/\bchoose\b|\bup to \d|\bcards? (?:in|from) (?:your|their|the)\b|\bbattle cards?\b.*\b(?:with|that)\b|\ball (?:of )?(?:your|their)\b|\bopponent'?s\b.*\bcards?\b/.test(t)) return "selectors";
  return "effects";
}

type Lane = "moments" | "conditions" | "selectors" | "effects";
const clusters: Record<Lane, Map<string, { key: string; clause: string; printed: string }[]>> = { moments: new Map(), conditions: new Map(), selectors: new Map(), effects: new Map() };
for (const [key, r] of Object.entries(readings)) {
  if (!r.unread.length) continue;
  const moment = r.kind === "auto" ? r.unread.find(isMoment) : undefined;
  const clause = moment ?? r.unread[0];
  if (!moment && REFUSED_ON_PURPOSE.test(clause)) continue;
  const lane: Lane = moment ? "moments" : laneOf(clause);
  const k = norm(clause);
  const list = clusters[lane].get(k) ?? [];
  list.push({ key, clause, printed: r.printed });
  clusters[lane].set(k, list);
}

const TITLE: Record<Lane, string> = {
  moments: "[Auto] skills whose unread clause is their moment (lane T)",
  conditions: "unread skills whose first unread clause reads like a condition (lane C)",
  selectors: "unread skills whose first unread clause reads like a choice, description or place (lane S)",
  effects: "the other unread skills (lane E)",
};
fs.mkdirSync(outDir, { recursive: true });
const all = Object.values(readings);
const summary: string[] = [];
for (const lane of Object.keys(clusters) as Lane[]) {
  const sorted = [...clusters[lane].entries()].sort((a, b) => b[1].length - a[1].length || a[0].localeCompare(b[0]));
  const skills = sorted.reduce((n, [, v]) => n + v.length, 0);
  const md = [
    `# ${skills} ${TITLE[lane]}, in ${sorted.length} clusters`,
    "",
    `Generated by \`npm run arena:unread-clusters\` from ${path.basename(readingsFile)}${label ? ` (${label})` : ""}. Each cluster: the clause with names → X, colours → C, numbers → N; its skills; one printed example. Teach families generally, largest first — never a card-id special case. A clause that is really another lane's: leave it.`,
    "",
  ];
  for (const [k, v] of sorted) md.push(`## ${v.length} × "${k}"`, `- skills: ${v.map((x) => x.key).join(" ")}`, `- e.g. ${v[0].key}: UNREAD "${v[0].clause.slice(0, 160)}" — ${v[0].printed.replace(/<br>/g, " / ").slice(0, 260)}`, "");
  fs.writeFileSync(path.join(outDir, `${lane}.md`), md.join("\n"));
  summary.push(`${lane} ${skills} skills / ${sorted.length} clusters`);
}
console.log(`arena:unread-clusters: ${all.length} skills, ${all.filter((r) => r.unread.length).length} unread → ${outDir}: ${summary.join("; ")}`);
